{
  "version": 2,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/verify/(.*)",
      "destination": "/api/verify.js"
    },
    {
      "source": "/api/report",
      "destination": "/api/report.js"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin.js"
    },
    {
      "source": "/api/test",
      "destination": "/api/test.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}