{
  "version": 2,
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/v1/auth/login",                            "destination": "/api/v1/auth.js?action=login" },
    { "source": "/api/v1/auth/logout",                           "destination": "/api/v1/auth.js?action=logout" },
    { "source": "/api/v1/auth/refresh",                          "destination": "/api/v1/auth.js?action=refresh" },
    { "source": "/api/v1/auth/setup",                            "destination": "/api/v1/auth.js?action=setup" },
    { "source": "/api/v1/admin/dashboard",                       "destination": "/api/v1/dashboard.js" },
    { "source": "/api/v1/admin/settings",                        "destination": "/api/v1/dashboard.js?mode=settings" },
    { "source": "/api/v1/admin/students/eligible",               "destination": "/api/v1/students.js?mode=eligible" },
    { "source": "/api/v1/admin/students",                        "destination": "/api/v1/students.js" },
    { "source": "/api/v1/admin/students/:id",                    "destination": "/api/v1/students.js?id=:id" },
    { "source": "/api/v1/admin/courses",                         "destination": "/api/v1/courses.js" },
    { "source": "/api/v1/admin/courses/:id",                     "destination": "/api/v1/courses.js?id=:id" },
    { "source": "/api/v1/admin/certificates/issue",              "destination": "/api/v1/certificates.js?action=issue" },
    { "source": "/api/v1/admin/certificates",                    "destination": "/api/v1/certificates.js" },
    { "source": "/api/v1/admin/certificates/:id/revoke",         "destination": "/api/v1/certificates.js?action=revoke&id=:id" },
    { "source": "/api/v1/admin/logs",                            "destination": "/api/v1/logs.js" },
    { "source": "/api/v1/admin/reports",                         "destination": "/api/v1/reports.js" },
    { "source": "/api/v1/admin/reports/:id",                     "destination": "/api/v1/reports.js?id=:id" },
    { "source": "/api/v1/admin/users",                           "destination": "/api/v1/users.js" },
    { "source": "/api/v1/admin/users/:id",                       "destination": "/api/v1/users.js?id=:id" },
    { "source": "/api/v1/report",                                "destination": "/api/v1/reports.js" },
    { "source": "/api/v1/verify",                                "destination": "/api/v1/verify.js" },
    { "source": "/api/v1/health",                                "destination": "/api/v1/health.js" },
    { "source": "/((?!api/).*)",                                 "destination": "/index.html" }
  ]
}