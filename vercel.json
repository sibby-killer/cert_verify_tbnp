{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/admin/auth/login",
      "destination": "/api/admin.js"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin.js"
    },
    {
      "source": "/api/verify",
      "destination": "/api/verify.js"
    },
    {
      "source": "/api/report",
      "destination": "/api/report.js"
    },
    {
      "source": "/api/test",
      "destination": "/api/test.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/dist/index.html"
    }
  ]
}