TURSO_DATABASE_URL=libsql://your-db.your-group.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# JWT — must be at least 32 random characters
JWT_SECRET=supersecretkey_change_this_to_random_32_chars_min

# Token TTLs (parsed by env.parseTTLms — supports s/m/h/d suffixes)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Email (optional — certificate emails are non-critical)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Public URL of the frontend (used for QR code verify URLs and CORS)
CLIENT_URL=https://cert-verify-tbnp.vercel.app